    {
      "name": "03 - Items (CRUD)",
      "item": [
        {
          "name": "POST /items — criar item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Teclado Mecânico\",\n    \"description\": \"Switch Cherry MX Red, RGB, ABNT2\",\n    \"price\": 499.90,\n    \"category\": \"periféricos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            },
            "description": "Cria um novo item. Salva o 'id' na variável de ambiente 'itemId'."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verifica se temos token antes de enviar",
                  "if (!pm.environment.get('token')) {",
                  "    console.warn('Variável token não encontrada. Execute POST /auth/login primeiro.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Body tem id, name, price e timestamps', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.name).to.be.a('string');",
                  "    pm.expect(body.price).to.be.a('number');",
                  "    pm.expect(body.createdAt).to.be.a('string');",
                  "    pm.expect(body.version).to.equal(1);",
                  "});",
                  "",
                  "// Salva o id para usar nas próximas requisições",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "    pm.environment.set('itemId', body.id);",
                  "    console.log('itemId salvo: ' + body.id);",
                  "}"
                ]
              }
            }
          ]
        },
