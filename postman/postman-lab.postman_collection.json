    {
      "name": "04 - Errors e Edge Cases",
      "item": [
        {
          "name": "GET /rate-limit — aciona rate limit (429)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rate-limit",
              "host": ["{{baseUrl}}"],
              "path": ["rate-limit"]
            },
            "description": "EXERCÍCIO: Execute este request 4+ vezes em menos de 10 segundos para provocar 429. Observe os headers RateLimit-*."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Aceita 200 (dentro do limite) ou 429 (limite excedido)",
                  "pm.test('Status 200 ou 429', function () {",
                  "    pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test('Headers de rate limit presentes no 429', function () {",
                  "        pm.expect(pm.response.headers.get('RateLimit-Limit') ||",
                  "                  pm.response.headers.get('X-RateLimit-Limit')).to.not.be.undefined;",
                  "    });",
                  "    console.log('Rate limit atingido! Headers:', JSON.stringify({",
                  "        limit: pm.response.headers.get('RateLimit-Limit'),",
                  "        remaining: pm.response.headers.get('RateLimit-Remaining'),",
                  "        reset: pm.response.headers.get('RateLimit-Reset')",
                  "    }));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /server-error — erro 500",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/server-error",
