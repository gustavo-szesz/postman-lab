    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "postman-lab",
    "description": "Laboratório completo para aprender Postman do zero. Inclui cenários de Auth, CRUD com validação, Rate Limit, Timeout e erros de servidor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script de nível de coleção: injeta X-Request-Id em todas as requisições",
          "pm.request.headers.add({",
          "    key: 'X-Request-Id',",
          "    value: pm.variables.replaceIn('{{$guid}}')",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Testa presença do header X-Request-Id em TODAS as respostas",
          "pm.test('X-Request-Id presente no response', function () {",
          "    pm.expect(pm.response.headers.get('X-Request-Id')).to.not.be.undefined;",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifica se a API está no ar. Deve retornar 200 com status 'ok'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type é JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Body tem status ok', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('ok');",
                  "    pm.expect(body.uptime).to.be.a('number');",
                  "    pm.expect(body.timestamp).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Tempo de resposta menor que 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Auth",
      "item": [
        {
          "name": "POST /auth/login — sucesso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login com credenciais válidas. Salva o token na variável de ambiente 'token'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response tem token e expiresIn', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tokenType).to.equal('Bearer');",
                  "    pm.expect(body.expiresIn).to.be.a('number');",
                  "    pm.expect(body.expiresAt).to.be.a('string');",
                  "});",
                  "",
                  "// Salva o token para usar nas próximas requisições",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.environment.set('token', body.token);",
                  "    console.log('Token salvo na variável de ambiente: token');",
                  "}"
                ]
              }
            }
          ]
        },
